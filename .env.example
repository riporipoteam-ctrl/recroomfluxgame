PORT=2059
HOST=0.0.0.0
NODE_ENV=development

# Same Firebase project used by Flux. Firebase Admin must authenticate through
# Application Default Credentials or GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_PROJECT_ID=flux-544a6
GOOGLE_APPLICATION_CREDENTIALS=
ADMIN_EMAIL=ripo.ripoteam@gmail.com

# Keep real service values in deployment/GitHub secrets, never in source control.
PHOTON_APP_ID=
PHOTON_APP_VERSION=flux-recroom-2022
PHOTON_REGION=eu

# Exact target client metadata.
RECROOM_BUILD_DATE=2022-05-19
RECROOM_BUILD_ID=8751857
RECROOM_MANIFEST_ID=6337851004861751095

# Optional public origin(s), comma-separated.
CORS_ORIGINS=http://localhost:3000

# Used by Windows host tooling; binaries remain outside the repo.
FLUX_RECROOM_CLIENT_DIR=

# Loopback proxy used by a Windows game host. The broker/agent fills the gateway
# URL and per-player session token at launch time; never commit a real token.
FLUX_RECROOM_GATEWAY_URL=
FLUX_RECROOM_SESSION_TOKEN=
FLUX_RECROOM_PROXY_HOST=127.0.0.1
FLUX_RECROOM_PROXY_PORT=2059
FLUX_RECROOM_PROXY_LOG=1

# Allow request/response-shape discovery for endpoints not implemented yet.
TRACE_UNKNOWN_ROUTES=true
TRACE_BODY_LIMIT=32768
